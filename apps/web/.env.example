# Frontend environment template — copy to `.env.local` (gitignored) and fill the secrets, or keep the
# non-secret defaults in `.env`. NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD
# time; everything else is read server-side only.

# --- Backend wiring (public) ---
NEXT_PUBLIC_API_URL=http://localhost:2026
NEXT_PUBLIC_ASSISTANT_ID=nora
NEXT_PUBLIC_STUDIO_ASSISTANT_ID=nora_a2ui
NEXT_PUBLIC_OPS_API_URL=http://localhost:8000

# --- Marketing render proxy (server-side only; do NOT prefix NEXT_PUBLIC) ---
# /api/render/video polls + streams OpenRouter video jobs, keeping the key off the client.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Google Workspace capability (optional; OFF by default) ---
# Flip to true + fill the secrets below to enable Google sign-in and the incremental Workspace grant.
NEXT_PUBLIC_WORKSPACE_ENABLED=false
# Set true together with the backend's AUTH_TYPE=custom: requires sign-in before any Aegra call so
# threads are isolated per operator. Leave false for the keyless (AUTH_TYPE=noop) demo.
NEXT_PUBLIC_AUTH_REQUIRED=false
NEXTAUTH_URL=http://localhost:3000
# AUTH_SECRET signs the NextAuth session AND the JWT the backend (auth.py) verifies — it MUST equal
# the backend's NEXTAUTH_SECRET. Generate one with:  openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_SECRET=
# From your Google OAuth "Web application" client — the values inside client_secret_*.json → web.*
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
