# --- Provider keys (set the one(s) for your chosen model) ---
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# --- Model selection (provider-agnostic; "provider:model") ---
# Defaults match the existing OpenAI setup; switch provider by changing the string.
NORA_MODEL=openai:gpt-4o
NORA_ROUTER_MODEL=openai:gpt-4o-mini
NORA_EMBEDDING_MODEL=openai:text-embedding-3-small
# NORA_EMBEDDING_DIMS=1536

# --- Marketing / rendering ---
NORA_RENDERER=placeholder          # placeholder (default, no external calls) | openrouter
# NORA_OPENROUTER_API_KEY=
# NORA_OPENROUTER_VIDEO_MODEL=     # TODO: set when the real text-to-video adapter is wired

# --- Behaviour knobs (optional; see config.py for defaults) ---
# NORA_MAX_SQL_ROWS=200
# NORA_MARKETING_MAX_REVISIONS=2
# NORA_MARKETING_NUM_CONCEPTS=3

# --- Observability (LangSmith tracing; all optional) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=curry-nomad

# --- Observability (Langfuse tracing; all optional) ---
# Self-host locally: `docker compose -f docker-compose.langfuse.yml up -d` (UI on :3001). The
# keys below match the compose headless-init values, so this block works copy-paste.
# LANGFUSE_PUBLIC_KEY=pk-lf-nora-public
# LANGFUSE_SECRET_KEY=sk-lf-nora-secret
#
# Two ways the app reaches Langfuse — uncomment the rows for the path you run:
#
#   • CLI demo (`uv run --extra langfuse python -m nora.app ...`): a LangChain CallbackHandler,
#     uses LANGFUSE_HOST.
# LANGFUSE_HOST=http://localhost:3001
#
#   • Full web app: Aegra auto-instruments over OpenTelemetry — set OTEL_TARGETS=LANGFUSE and
#     point LANGFUSE_BASE_URL at the Langfuse UI. On the host (`aegra dev`) that's localhost:3001;
#     from the container (docker compose) it's host.docker.internal:3001. Traces group by thread
#     in the Sessions view.
# OTEL_TARGETS=LANGFUSE
# LANGFUSE_BASE_URL=http://localhost:3001

# --- Aegra backend (serving the `nora` graph over the Agent Protocol; see aegra.json) ---
# `uv run aegra dev` reads this file and auto-starts PostgreSQL in Docker; it needs the
# OPENAI_API_KEY above (chat models + the semantic Store embeddings). DATABASE_URL is only
# needed for `aegra serve` (production, external Postgres):
# DATABASE_URL=postgresql://user:password@localhost:5432/aegra
