# --- Provider keys (set the one(s) for your chosen model) ---
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# --- Model selection (provider-agnostic; "provider:model") ---
# Defaults match the existing OpenAI setup; switch provider by changing the string.
NORA_MODEL=openai:gpt-4o
NORA_ROUTER_MODEL=openai:gpt-4o-mini
NORA_EMBEDDING_MODEL=openai:text-embedding-3-small
# NORA_EMBEDDING_DIMS=1536

# --- Marketing / media rendering (OpenRouter) ---
NORA_RENDERER=placeholder          # placeholder (default, no external calls, no spend) | openrouter
# Real media generation: set NORA_RENDERER=openrouter + the key below. Per-shot stills + a hero
# image (sync) and one image→video job per shot (async; the UI polls). Models are OpenRouter ids
# (NOT init_chat_model strings); defaults are the cheapest tier and all overridable.
# NORA_OPENROUTER_API_KEY=
# NORA_OPENROUTER_IMAGE_MODEL=black-forest-labs/flux.2-flex
# NORA_OPENROUTER_VIDEO_MODEL=google/veo-3.1-lite
# NORA_RENDER_ASPECT_RATIO=9:16
# NORA_RENDER_RESOLUTION=720p
# NORA_RENDER_VIDEO_DURATION_S=6
# NORA_RENDER_MAX_SHOTS=4            # cap shots rendered (cost guard)
# image→video needs a PUBLIC URL OpenRouter can fetch the first-frame still from — it can't reach
# localhost, so unset means text→video fallback. Point this at a tunnel/deploy origin serving /media:
# NORA_MEDIA_PUBLIC_BASE_URL=https://your-public-host

# --- Behaviour knobs (optional; see config.py for defaults) ---
# NORA_MAX_SQL_ROWS=200
# NORA_MARKETING_MAX_REVISIONS=2
# NORA_MARKETING_NUM_CONCEPTS=3

# --- Observability (LangSmith tracing; all optional) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=curry-nomad

# --- Observability (Langfuse tracing; all optional) ---
# Self-host locally: `docker compose -f docker-compose.langfuse.yml up -d` (UI on :3001). The
# keys below match the compose headless-init values, so this block works copy-paste.
# LANGFUSE_PUBLIC_KEY=pk-lf-nora-public
# LANGFUSE_SECRET_KEY=sk-lf-nora-secret
#
# Two ways the app reaches Langfuse — uncomment the rows for the path you run:
#   • CLI demo (`uv run --extra langfuse python -m nora.app ...`): a LangChain CallbackHandler,
#     uses LANGFUSE_HOST.
# LANGFUSE_HOST=http://localhost:3001
#   • Full web app: Aegra auto-instruments over OpenTelemetry — set OTEL_TARGETS=LANGFUSE and point
#     LANGFUSE_BASE_URL at the Langfuse UI. On the host (`aegra dev`) that's localhost:3001; from the
#     container (docker compose) it's host.docker.internal:3001. Traces group by thread (Sessions).
# OTEL_TARGETS=LANGFUSE
# LANGFUSE_BASE_URL=http://localhost:3001

# --- Backend (serving the `nora` graph over the Agent Protocol; see aegra.json) ---
# Local dev: `uv run --extra aegra aegra dev` reads this file, auto-starts a PostgreSQL container (pgvector) via
# Docker, applies migrations, and serves the graph on :2026. It needs the OPENAI_API_KEY above
# (chat models + the semantic Store embeddings). `aegra dev` manages Postgres for you with these
# defaults — override only to point at an external database:
# POSTGRES_USER=aegra
# POSTGRES_PASSWORD=aegra
# POSTGRES_DB=aegra
#
# Production / containers (`aegra serve`, e.g. docker compose): provide a running Postgres via
# DATABASE_URL (takes precedence over POSTGRES_*):
# DATABASE_URL=postgresql://aegra:aegra@localhost:5432/aegra
# AUTH_TYPE=noop                     # keyless (default); set `custom` to enable an auth handler
# REDIS_BROKER_ENABLED=false         # single-instance demo runs in-process (no Redis)

# --- Google Workspace capability (optional; OFF by default) ---
# An agent that acts on the logged-in operator's OWN Google account (Gmail/Calendar) via the
# self-hosted Google Workspace MCP server. Demo-only: publish the Google OAuth app in "Testing" mode
# (<=100 named test users, no verification; refresh tokens expire after 7 days). To enable the demo:
#   1) uv sync --extra workspace            # langchain-mcp-adapters + pyjwt
#   2) flip the flag + point at the MCP server (below)
#   3) AUTH_TYPE=custom + NEXTAUTH_SECRET   # per-operator identity (Plane 1); see auth.py
#   4) start the MCP server: docker compose --profile workspace up  (or its CLI on :8001)
# NORA_WORKSPACE_ENABLED=false
# NORA_WORKSPACE_MCP_URL=http://localhost:8001   # http://workspace-mcp:8001 under docker compose
# NORA_WORKSPACE_PERMISSIONS=gmail:send docs:full sheets:full tasks:full drive:readonly
#
# Google OAuth app (used by the web app's NextAuth login + the incremental "Connect Workspace" grant,
# AND by the MCP server). Read straight from the env — never Settings fields.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Shared secret the web app signs its session JWTs with and auth.py verifies (use >=32 random bytes):
# NEXTAUTH_SECRET=
# AUTH_TYPE=custom                   # required for the workspace demo (overrides the noop default)
