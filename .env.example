# --- Provider keys (set the one(s) for your chosen model) ---
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# --- Model selection (provider-agnostic; "provider:model") ---
# Defaults match the existing OpenAI setup; switch provider by changing the string.
NORA_MODEL=openai:gpt-4o
NORA_ROUTER_MODEL=openai:gpt-4o-mini
NORA_EMBEDDING_MODEL=openai:text-embedding-3-small
# NORA_EMBEDDING_DIMS=1536

# --- Marketing / rendering ---
NORA_RENDERER=placeholder          # placeholder (default, no external calls) | openrouter
# NORA_OPENROUTER_API_KEY=
# NORA_OPENROUTER_VIDEO_MODEL=     # TODO: set when the real text-to-video adapter is wired

# --- Behaviour knobs (optional; see config.py for defaults) ---
# NORA_MAX_SQL_ROWS=200
# NORA_MARKETING_MAX_REVISIONS=2
# NORA_MARKETING_NUM_CONCEPTS=3

# --- Observability (LangSmith tracing; all optional) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=curry-nomad

# --- Observability (Langfuse tracing; all optional) ---
# Self-host locally: `docker compose -f docker-compose.langfuse.yml up -d` (UI on :3001). The
# keys below match the compose headless-init values, so this block works copy-paste.
# LANGFUSE_PUBLIC_KEY=pk-lf-nora-public
# LANGFUSE_SECRET_KEY=sk-lf-nora-secret
#
# The CLI demo (`uv run --extra langfuse python -m nora.app ...`) attaches a LangChain
# CallbackHandler that reaches Langfuse at LANGFUSE_HOST.
# LANGFUSE_HOST=http://localhost:3001

# --- Backend (serving the `nora` graph over the Agent Protocol; see langgraph.json) ---
# `uv run langgraph dev` reads this file and serves the graph on :2024 (in-memory; no Postgres).
# It needs the OPENAI_API_KEY above (chat models + the semantic Store embeddings).
